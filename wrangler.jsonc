{
  "name": "kampus-store",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "observability": { "enabled": true },
  "vars": { "SUPABASE_URL": "https://fumhbixyhdflfkweabir.supabase.co" },
  "routes": [
    { "pattern": "store.kampus-link.com", "zone_name": "kampus-link.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/p/*", "/api/*", "/partners", "/partners/", "/admin", "/admin/", "/a/*"]
  }
}
