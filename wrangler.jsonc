{
  "name": "kampus-store",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/p/*", "/api/*", "/partners", "/partners/", "/admin", "/admin/"]
  }
}
